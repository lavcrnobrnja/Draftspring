[Unit]
Description=DraftSpring Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/draftspring/backend
EnvironmentFile=/opt/draftspring/backend/.env
ExecStart=/opt/draftspring/backend/.venv/bin/python -m app.worker_main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
