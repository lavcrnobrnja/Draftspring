# DraftSpring example config. Copy to .env and fill in your own values.
# Never commit .env.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8223
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
WORKER_ID=worker-01
DATABASE_PATH=./data/ghostwriter.db

# CORS / cookies
CORS_ORIGINS=http://localhost:5173,http://localhost:8223
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# AI providers. In development, the app uses MockLLM unless APP_ENV=production.
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-pro

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6
# Optional OpenAI-compatible Anthropic proxy URL. Leave empty for native Anthropic API.
ANTHROPIC_BASE_URL=

# Ghost integration
GHOST_URL=https://your-ghost-site.example
GHOST_ADMIN_API_KEY=

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL_PREFIX=

# Email / magic links
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=content@example.com
EMAIL_FROM_NAME=DraftSpring

# Optional Stripe SaaS/productization layer. Leave blank for internal use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=7

# Optional Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin / limits
ADMIN_EMAILS=
PER_ARTICLE_COST_CEILING_CENTS=250
MAX_CONCURRENT_ARTICLES=10
DAILY_IMAGE_GENERATION_CAP=50
LOG_LEVEL=INFO
